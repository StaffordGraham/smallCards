{
    "version": "2.0.0",
    "tasks": [
        {
            // serve.py: smallCards plus a listing of the deal library folder
            "label": "Serve smallCards",
            "type": "shell",
            "command": "python serve.py",
            "isBackground": true,
            "problemMatcher": {
                "owner": "serve",
                // serve.py reports no problems: this pattern never matches, but VS Code requires one
                "pattern": {
                    "regexp": "^__no_problems__(.*):(\\d+):(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^__no_problems__$",
                    "endsPattern": "^smallCards server"
                }
            }
        }
    ]
}
